---
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <circle cx="16" cy="16" r="13" stroke="var(--brand)" stroke-width="3.5" />
  <path d="M16 3a13 13 0 0113 13" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round" />
  <circle cx="16" cy="16" r="6.5" stroke="var(--steel)" stroke-width="1.3" stroke-dasharray="2 2.4" />
  <circle cx="16" cy="16" r="2.2" fill="var(--accent)" />
</svg>

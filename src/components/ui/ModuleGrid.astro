---
import { MODULES } from '@/data/curriculum';
const { detailed = false } = Astro.props;
---
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  {MODULES.map((m) => {
    const Tag = m.live ? 'a' : 'div';
    return (
      <Tag href={m.live ? `/learn/${m.id}/` : undefined} class:list={['mod card p-5 flex flex-col', m.live ? 'live' : 'soon']}>
        <div class="flex items-center gap-3">
          <span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={m.icon} /></svg></span>
          <span class="num text-xs text-muted">{m.code}</span>
          <span class:list={['badge ml-auto', m.live && 'on']}>{m.live ? 'Available' : 'In production'}</span>
        </div>
        <h3 class="font-display font-semibold text-lg mt-4">{m.title}</h3>
        <p class="text-sm text-muted mt-1.5 flex-1">{m.blurb}</p>
        {detailed && (
          <ul class="mt-4 pt-4 border-t border-line text-sm space-y-1.5">
            {m.lessons.map((l) => <li class="flex gap-2 text-muted"><span class="text-steel">–</span>{l.title}</li>)}
          </ul>
        )}
        {m.live && <div class="mt-4 text-sm font-semibold text-accent">Start module →</div>}
        {!detailed && !m.live && <div class="mt-4 text-xs text-muted num">{m.lessons.length} lessons planned</div>}
      </Tag>
    );
  })}
</div>
<style>
  .mod.live { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); transition: transform .15s, border-color .15s; }
  .mod.live:hover { transform: translateY(-2px); border-color: var(--accent); }
  .mod.soon { box-shadow: none; background: color-mix(in srgb, var(--surface) 60%, transparent); }
  .ico { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 10px; background: var(--surface-2); color: var(--brand); border: 1px solid var(--line); }
  .mod.live .ico { color: var(--accent); }
  .badge { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; padding: .18rem .5rem; border-radius: 99px; border: 1px solid var(--line); color: var(--muted); }
  .badge.on { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, transparent); }
</style>

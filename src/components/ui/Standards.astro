---
// Standards comparison box. Slot content is a Markdown table.
interface Props { title?: string }
const { title = 'What the standards say' } = Astro.props;
---
<section class="std">
  <header>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h11l3 3v13H5z" /><path d="M9 9h6M9 13h6M9 17h4" /></svg>
    <span>{title}</span>
  </header>
  <div class="std-b"><slot /></div>
  <footer>Paraphrased for learning. Clause numbers and values change between revisions: verify against the current edition before use.</footer>
</section>
<style>
  .std { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; margin: 2rem 0; background: var(--surface); }
  header { display: flex; align-items: center; gap: .55rem; padding: .7rem 1.1rem; font-family: var(--font-display); font-weight: 650; background: color-mix(in srgb, var(--yellow) 12%, var(--surface)); border-bottom: 1px solid var(--line); color: var(--text); }
  header svg { color: var(--yellow); }
  .std-b { padding: .3rem .5rem; }
  .std-b :global(td:first-child) { font-family: var(--font-mono); font-size: .8rem; font-weight: 600; white-space: nowrap; color: var(--text); }
  .std-b :global(tr:last-child td) { border-bottom: 0; }
  footer { padding: .6rem 1.1rem; font-size: .76rem; color: var(--muted); border-top: 1px solid var(--line); }
</style>

---
import Base from './Base.astro';
import { moduleById } from '@/data/curriculum';
import type { MarkdownHeading } from 'astro';
interface Props {
  id: string; moduleId: string; slug: string; headings: MarkdownHeading[];
  data: { title: string; summary: string; minutes: number; level: string; standards: string[]; outcomes: string[] };
}
const { id, moduleId, slug, headings, data } = Astro.props;
const mod = moduleById(moduleId);
const live = mod.lessons.filter((l) => l.slug);
const idx = live.findIndex((l) => l.slug === slug);
const prev = live[idx - 1], next = live[idx + 1];
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={data.title} description={data.summary}>
  <div class="mx-auto max-w-[88rem] px-4 sm:px-6 lg:grid lg:grid-cols-[15.5rem_minmax(0,1fr)] xl:grid-cols-[15.5rem_minmax(0,1fr)_13rem] gap-10">
    <aside class="hidden lg:block py-10" data-pagefind-ignore>
      <div class="sticky top-24">
        <a href={`/learn/${mod.id}/`} class="eyebrow hover:underline">{mod.code} · {mod.title}</a>
        <ol class="mt-4 space-y-0.5 text-sm">
          {mod.lessons.map((l, i) => (
            <li>
              {l.slug ? (
                <a href={`/learn/${mod.id}/${l.slug}/`} data-lesson-id={`${mod.id}/${l.slug}`}
                  class:list={['side-link', l.slug === slug && 'active']}>
                  <span class="dot" aria-hidden="true"></span><span>{l.title}</span>
                </a>
              ) : (
                <span class="side-link opacity-50"><span class="dot"></span>{l.title}</span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </aside>

    <article class="py-10 min-w-0" data-pagefind-body>
      <nav class="text-sm text-muted flex flex-wrap gap-2 mb-5" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href="/learn/" class="hover:text-text">Curriculum</a><span>/</span>
        <a href={`/learn/${mod.id}/`} class="hover:text-text">{mod.title}</a>
      </nav>
      <p class="eyebrow">{mod.code} · Lesson {idx + 1} of {live.length}</p>
      <h1 class="text-4xl sm:text-5xl font-bold mt-2 max-w-3xl">{data.title}</h1>
      <p class="mt-4 text-lg text-muted max-w-2xl">{data.summary}</p>
      <div class="mt-5 flex flex-wrap items-center gap-2 text-xs num" data-pagefind-ignore>
        <span class="chip">{data.minutes} min</span>
        <span class="chip">{data.level}</span>
        {data.standards.map((s) => <span class="chip chip-std">{s}</span>)}
      </div>
      {data.outcomes.length > 0 && (
        <div class="card mt-8 p-5 max-w-3xl">
          <div class="eyebrow" style="color: var(--brand)">After this lesson you can</div>
          <ul class="mt-3 grid gap-2 text-[.95rem]">
            {data.outcomes.map((o) => <li class="flex gap-2.5"><span class="text-ok font-bold">✓</span><span>{o}</span></li>)}
          </ul>
        </div>
      )}

      <div class="prose mt-10"><slot /></div>

      <div class="mt-14 max-w-3xl" data-pagefind-ignore>
        <button id="done-btn" class="btn btn-ghost w-full justify-center py-3" data-id={id}>
          <span class="done-off">Mark lesson complete</span><span class="done-on">✓ Completed · click to undo</span>
        </button>
        <div class="grid sm:grid-cols-2 gap-3 mt-4">
          {prev ? <a class="card p-4 hover:border-brand" href={`/learn/${mod.id}/${prev.slug}/`}><div class="text-xs text-muted">← Previous</div><div class="font-display font-semibold mt-1">{prev.title}</div></a> : <span></span>}
          {next ? <a class="card p-4 text-right hover:border-brand" href={`/learn/${mod.id}/${next.slug}/`}><div class="text-xs text-muted">Next →</div><div class="font-display font-semibold mt-1">{next.title}</div></a>
            : <a class="card p-4 text-right hover:border-brand" href="/learn/"><div class="text-xs text-muted">Module complete →</div><div class="font-display font-semibold mt-1">Back to curriculum</div></a>}
        </div>
      </div>
    </article>

    <aside class="hidden xl:block py-10" data-pagefind-ignore>
      <div class="sticky top-24 text-sm">
        <div class="eyebrow" style="color: var(--muted)">On this page</div>
        <ul class="mt-3 space-y-2 border-l border-line">
          {toc.map((h) => <li><a href={`#${h.slug}`} class="toc-link block pl-3 -ml-px border-l border-transparent text-muted hover:text-text">{h.text}</a></li>)}
        </ul>
      </div>
    </aside>
  </div>

  <script>
    import { getProgress, toggleProgress, paintProgress } from '@/lib/progress';
    const btn = document.getElementById('done-btn')!;
    const id = btn.dataset.id!;
    const paint = () => { btn.classList.toggle('is-done', getProgress().includes(id)); paintProgress(); };
    btn.addEventListener('click', () => { toggleProgress(id); paint(); });
    paint();

    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) links.forEach((l) => l.classList.toggle('on', l.hash === `#${e.target.id}`));
    }, { rootMargin: '-15% 0px -70% 0px' });
    document.querySelectorAll('.prose h2[id]').forEach((h) => io.observe(h));
  </script>
</Base>

<style is:global>
  .side-link { display: flex; gap: .65rem; align-items: baseline; padding: .42rem .6rem; border-radius: 8px; color: var(--muted); line-height: 1.35; }
  a.side-link:hover { color: var(--text); background: var(--surface-2); }
  .side-link.active { color: var(--text); background: var(--surface-2); font-weight: 600; }
  .side-link .dot { flex: none; width: .55rem; height: .55rem; border-radius: 50%; border: 1.5px solid var(--steel); transform: translateY(-1px); }
  .side-link.active .dot { border-color: var(--accent); }
  .is-complete .dot, .side-link.is-complete .dot { background: var(--ok); border-color: var(--ok); }
  .chip { border: 1px solid var(--line); background: var(--surface); padding: .22rem .6rem; border-radius: 99px; color: var(--muted); }
  .chip-std { color: var(--yellow); border-color: color-mix(in srgb, var(--yellow) 40%, var(--line)); }
  .toc-link.on { color: var(--text); border-color: var(--accent); }
  #done-btn .done-on { display: none; }
  #done-btn.is-done { border-color: var(--ok); color: var(--ok); }
  #done-btn.is-done .done-on { display: inline; } #done-btn.is-done .done-off { display: none; }
</style>

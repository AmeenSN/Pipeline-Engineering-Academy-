---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found">
  <section class="mx-auto max-w-xl px-4 py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="text-4xl font-bold mt-3">This section of line isn't built yet</h1>
    <p class="text-muted mt-4">The page you're looking for doesn't exist or is still in production.</p>
    <a href="/learn/" class="btn btn-primary mt-8">Go to the curriculum</a>
  </section>
</Base>

---
import Base from '@/layouts/Base.astro';
const tools = [
  { t: 'Grade comparison', d: 'Wall thickness and steel tonnage for every API 5L grade at your pressure and diameter.', h: '/learn/materials/carbon-steel-grades/', tag: 'Materials' },
  { t: 'Carbon equivalent and weldability', d: 'CE(IIW) and Pcm from chemistry, checked against API 5L PSL2 limits.', h: '/learn/materials/carbon-steel-grades/', tag: 'Materials' },
  { t: 'How line pipe is made', d: 'Step through seamless, HFW, LSAW and spiral pipe manufacturing.', h: '/learn/materials/pipe-manufacturing/', tag: 'Materials' },
  { t: 'Carbon steel or CRA?', d: 'CO₂ corrosion rate, inhibitor availability and wall loss over the design life.', h: '/learn/materials/cra-clad-nonmetallic/', tag: 'Materials' },
  { t: 'Inside the pipe wall', d: 'Layer-by-layer view of carbon steel, clad, lined, solid CRA, RTP and GRE pipe.', h: '/learn/materials/cra-clad-nonmetallic/', tag: 'Materials' },
  { t: 'Flange pressure class selector', d: 'ASME B16.5 class for a design pressure and temperature, with rating curves.', h: '/learn/materials/fittings-flanges-valves/', tag: 'Components' },
  { t: 'Pipeline valve types', d: 'Operate ball, gate, check and globe valves and see which are piggable.', h: '/learn/materials/fittings-flanges-valves/', tag: 'Components' },
  { t: 'Three ways to turn a pipeline', d: 'Radius and curve length of elastic, cold and induction bends for the same turn.', h: '/learn/bends/elastic-bends/', tag: 'Bends' },
  { t: 'Elastic bend radius check', d: 'Minimum elastic radius from the combined stress limit.', h: '/learn/bends/elastic-bends/', tag: 'Bends' },
  { t: 'Cold field bend planner', d: 'Maximum angle per joint and the number of joints needed for a turn.', h: '/learn/bends/cold-field-bends/', tag: 'Bends' },
  { t: 'Hot induction bend designer', d: 'Wall thinning, intrados stress and mother pipe wall for any radius.', h: '/learn/bends/hot-induction-bends/', tag: 'Bends' },
  { t: 'Miter bend rule checker', d: 'Whether a miter is permitted under ASME B31.4 or B31.8 at your stress level.', h: '/learn/bends/miters-segmental-bends/', tag: 'Bends' },
  { t: 'Wall thickness calculator', d: 'Barlow pressure design to ASME B31.4 and B31.8, with design factor, temperature derating and corrosion allowance.', h: '/learn/mechanical-design/wall-thickness/', tag: 'Design' },
  { t: 'Stress state explorer', d: 'Hoop, longitudinal and Von Mises stress for restrained and unrestrained pipe, plotted on the yield envelope.', h: '/learn/mechanical-design/pipe-stresses/', tag: 'Stress' },
  { t: 'Virtual anchor and end movement', d: 'Full restraint force, soil friction, anchor length and free-end expansion.', h: '/learn/mechanical-design/thermal-expansion-anchors/', tag: 'Stress' },
  { t: 'Soil and traffic load', d: 'Crown pressure from soil and wheel loads and the resulting ovalisation.', h: '/learn/mechanical-design/external-loads-buoyancy/', tag: 'Burial' },
  { t: 'Buoyancy check', d: 'Flotation safety factor and the concrete coating thickness needed in water or sabkha brine.', h: '/learn/mechanical-design/external-loads-buoyancy/', tag: 'Burial' },
  { t: 'Upheaval buckling explorer', d: 'Required download and cover for a hot buried line over a trench imperfection.', h: '/learn/mechanical-design/upheaval-buckling/', tag: 'Stability' },
  { t: 'Free span and VIV', d: 'Natural frequency, reduced velocity and the longest span free of vortex-induced vibration.', h: '/learn/mechanical-design/lateral-buckling-free-spans/', tag: 'Stability' },
  { t: 'Pressure-cycle fatigue life', d: 'Girth-weld fatigue life from pressure swings using S-N curves.', h: '/learn/mechanical-design/fatigue-dt-collapse/', tag: 'Integrity' },
  { t: 'Collapse and D/t', d: 'Elastic, plastic and combined collapse pressure against water depth.', h: '/learn/mechanical-design/fatigue-dt-collapse/', tag: 'Integrity' },
];
---
<Base title="Calculators" description="Interactive pipeline engineering calculators with shown working and SI/US units.">
  <section class="blueprint border-b border-line">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-6 py-14">
      <p class="eyebrow">Calculators hub</p>
      <h1 class="text-4xl sm:text-5xl font-bold mt-2">Every tool in one place</h1>
      <p class="mt-4 text-lg text-muted max-w-2xl">Each calculator lives inside the lesson that explains it, so the theory, assumptions and limits are always one scroll away.</p>
    </div>
  </section>
  <section class="mx-auto max-w-[88rem] px-4 sm:px-6 py-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((t) => (
      <a href={t.h} class="card p-5 hover:border-brand transition-colors flex flex-col">
        <span class="eyebrow">{t.tag}</span>
        <h2 class="font-display font-semibold text-lg mt-2">{t.t}</h2>
        <p class="text-sm text-muted mt-1.5 flex-1">{t.d}</p>
        <span class="mt-4 text-sm font-semibold text-accent">Open in lesson →</span>
      </a>
    ))}
  </section>
</Base>

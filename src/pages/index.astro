---
import Base from '@/layouts/Base.astro';
import ModuleGrid from '@/components/ui/ModuleGrid.astro';
import { MODULES, lessonCount } from '@/data/curriculum';
const features = [
  { t: 'Learn by moving things', d: 'Every concept has a diagram you can drag, slide and break. Raise the temperature and watch a buried line buckle.' },
  { t: 'Calculators you can trust', d: 'Each tool shows its working, runs on a tested engineering library and switches between SI and US units.' },
  { t: 'Standards side by side', d: 'ASME B31.4 and B31.8, API, ISO, DNV and Saudi Aramco SAES requirements compared in plain language.' },
  { t: 'Built for the field', d: 'Worked examples, common mistakes and site practice from desert, sabkha, rock and wadi terrain.' },
];
---
<Base>
  <section class="blueprint border-b border-line overflow-hidden">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-6 pt-16 pb-6 lg:pt-24 grid lg:grid-cols-[1.05fr_1fr] gap-10 items-center">
      <div>
        <p class="eyebrow">Onshore · Above-ground · Offshore</p>
        <h1 class="text-5xl sm:text-6xl xl:text-7xl font-bold mt-4 leading-[1.02]">Pipeline engineering, <span class="text-accent">made visible.</span></h1>
        <p class="mt-6 text-lg sm:text-xl text-muted max-w-xl">A one-stop academy for new and experienced pipeline engineers. Interactive lessons and calculators covering design, routing, construction, testing and operation.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/learn/mechanical-design/" class="btn btn-primary">Start with mechanical design →</a>
          <a href="/learn/" class="btn btn-ghost">Browse the curriculum</a>
        </div>
        <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4">
          {[[MODULES.length, 'modules'], [lessonCount, 'lessons planned'], ['9', 'interactive tools live']].map(([n, l]) => (
            <div><dt class="num text-3xl font-bold">{n}</dt><dd class="text-sm text-muted">{l}</dd></div>
          ))}
        </dl>
      </div>
      <div class="card p-3 sm:p-4">
        <svg viewBox="0 0 560 380" role="img" aria-label="Illustration of a buried pipeline crossing desert terrain, a road and a wadi, with a valve station" class="w-full">
          <defs>
            <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--brand)" stop-opacity=".16" /><stop offset="1" stop-color="var(--brand)" stop-opacity="0" /></linearGradient>
            <pattern id="hsoil" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="3" cy="4" r="1" fill="var(--yellow)" opacity=".5" /><circle cx="10" cy="10" r="1.2" fill="var(--yellow)" opacity=".3" /></pattern>
          </defs>
          <rect width="560" height="200" fill="url(#sky)" rx="10" />
          <circle cx="470" cy="60" r="22" fill="var(--yellow)" opacity=".85" />
          <path d="M0 150 Q70 110 140 140 T280 130 T420 150 T560 120 V200 H0Z" fill="var(--yellow)" opacity=".12" />
          <!-- ground surface -->
          <path id="gs" d="M0 190 H170 L185 190 H250 L270 190 H330 Q365 232 400 190 H560 V380 H0Z" fill="url(#hsoil)" />
          <path d="M0 190 H330 Q365 232 400 190 H560 V380 H0Z" fill="var(--yellow)" opacity=".07" />
          <path d="M0 190 H330 Q365 232 400 190 H560" fill="none" stroke="var(--text)" stroke-width="2" />
          <!-- road -->
          <rect x="176" y="183" width="84" height="8" rx="2" fill="var(--text)" />
          <rect x="196" y="166" width="38" height="14" rx="3" fill="var(--steel)" /><circle cx="204" cy="181" r="4" fill="var(--text)" /><circle cx="227" cy="181" r="4" fill="var(--text)" />
          <text x="218" y="158" text-anchor="middle" class="svg-label">road crossing</text>
          <text x="365" y="182" text-anchor="middle" class="svg-label">wadi</text>
          <!-- pipeline -->
          <path id="pl" d="M-10 250 H150 Q175 250 190 268 T240 286 T290 250 H315 Q345 250 355 276 T400 290 T440 250 H470 Q490 250 490 230 V176" fill="none" stroke="var(--steel)" stroke-width="13" stroke-linecap="round" />
          <path d="M-10 250 H150 Q175 250 190 268 T240 286 T290 250 H315 Q345 250 355 276 T400 290 T440 250 H470 Q490 250 490 230 V176" fill="none" stroke="var(--accent)" stroke-width="3" stroke-dasharray="10 10" style="animation: flow 1.1s linear infinite reverse" />
          <!-- valve station -->
          <path d="M478 168h24l-24 -18v18l24-18z" fill="var(--brand)" /><line x1="490" y1="159" x2="490" y2="140" stroke="var(--brand)" stroke-width="3" /><line x1="480" y1="140" x2="500" y2="140" stroke="var(--brand)" stroke-width="3" />
          <text x="490" y="128" text-anchor="middle" class="svg-label">sectionalizing valve</text>
          <!-- dimension -->
          <line x1="70" y1="192" x2="70" y2="242" stroke="var(--muted)" /><path d="M66 198l4-6 4 6M66 236l4 6 4-6" fill="none" stroke="var(--muted)" />
          <text x="78" y="222" class="svg-label">cover</text>
          <!-- profile strip -->
          <rect x="0" y="320" width="560" height="60" fill="var(--surface)" stroke="var(--line)" />
          <path d="M0 350 H170 L190 350 H330 Q365 372 400 350 H560" fill="none" stroke="var(--brand)" stroke-width="1.5" />
          {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <g><line x1={i * 80} x2={i * 80} y1="320" y2="380" stroke="var(--line)" /><text x={i * 80 + 5} y="334" class="svg-label">KP {i}+000</text></g>)}
        </svg>
      </div>
    </div>
    <div class="mx-auto max-w-[88rem] px-4 sm:px-6 pb-14 pt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {features.map((f, i) => (
        <div class="card p-5">
          <div class="num text-accent text-sm">0{i + 1}</div>
          <h3 class="font-display font-semibold mt-2">{f.t}</h3>
          <p class="text-sm text-muted mt-1.5">{f.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[88rem] px-4 sm:px-6 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <p class="eyebrow">Curriculum map</p>
        <h2 class="text-3xl sm:text-4xl font-bold mt-2">From line pipe to leak detection</h2>
      </div>
      <a href="/learn/" class="text-sm font-semibold text-brand hover:underline">See every lesson →</a>
    </div>
    <ModuleGrid />
  </section>
</Base>

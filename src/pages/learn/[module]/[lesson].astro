---
import { getCollection, render } from 'astro:content';
import Lesson from '@/layouts/Lesson.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => {
    const [module, lesson] = entry.id.split('/');
    return { params: { module, lesson }, props: { entry } };
  });
}
const { entry } = Astro.props;
const { module, lesson } = Astro.params;
const { Content, headings } = await render(entry);
---
<Lesson id={entry.id} moduleId={module!} slug={lesson!} headings={headings} data={entry.data}>
  <Content />
</Lesson>
